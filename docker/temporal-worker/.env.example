# Temporal Configuration
TEMPORAL_ADDRESS=host.containers.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentconsole-durable-workflows

# Flowise API URL (for calling AgentFlows)
FLOWISE_API_URL=http://host.containers.internal:3000

# Database Configuration (REQUIRED - same as main Flowise instance)
# The Temporal Worker connects directly to the database to:
# 1. Fetch workflow definitions
# 2. Look up API keys for AgentFlow authentication
DATABASE_TYPE=postgres
DATABASE_HOST=host.containers.internal
DATABASE_PORT=5432
DATABASE_NAME=flowise
DATABASE_USER=admin
DATABASE_PASSWORD=your_password
# DATABASE_SSL=true
# DATABASE_SSL_KEY_BASE64=<base64-encoded-cert>

# Secret Keys (same as main Flowise instance)
SECRETKEY_PATH=/root/.flowise
# FLOWISE_SECRETKEY_OVERWRITE=myencryptionkey

# Logging
LOG_LEVEL=info
LOG_PATH=/root/.flowise/logs
